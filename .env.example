# Copy to .env and adjust. Only needed on Windows (Spark requires JDK 17/21 + winutils).
# WGPT_JAVA_HOME=C:\Users\you\.jdks\jdk-21
# WGPT_HADOOP_HOME=C:\Users\you\.hadoop
# WGPT_SPARK_DRIVER_MEMORY=4g

# LLM providers (free tiers). Get keys at aistudio.google.com and console.groq.com.
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# WGPT_DEFAULT_MODEL=gpt-oss-120b
# WGPT_LLM_MODE=cache          # live | cache | replay
